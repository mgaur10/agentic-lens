# Agentic-Prism - Agent Identity IAM (Least Privilege)
# Copy to terraform.tfvars and set project_id and org_id.
# All 12 agents: supervisor, chat, events, eng-lead, eng-scout, eng-coder, eng-sentinel,
#   xray-manager, xray-librarian, xray-architect, xray-specialist, xray-auditor.

project_id = "agentic-prismv333"
org_id     = "your-org-id"
region     = "us-central1"

# Optional: Secret name for xray_librarian (secretAccessor). Set to "" to skip.
github_pat_secret_name = "github-pat-token"

# Client app (Streamlit): Scout/Coder/Sentinel/Events use ADC — grant predict to app runner.
# Default compute SA (Cloud Run/GCE): set to true to grant roles/aiplatform.user.
grant_aiplatform_to_default_compute_sa = true
# Optional: specific principal (e.g. "user:you@example.com" for local dev)
# client_app_principal = ""

# Optional: developer principal for local dev — fixes 403 aiplatform.sessions.create when running Streamlit locally.
# Set to your user email (from: gcloud config get-value account) so your ADC can create Agent Engine sessions.
# developer_principal = "user:your.email@example.com"

# Optional: principals from 403 logs (scripts/fetch_session_403_principal.py). Add the printed principal(s) here, then terraform apply.
# Session create is done by the reasoning engine identity (path ends with reasoningEngines/ENGINE_ID). Add its principalSubject from the CreateSession audit log.
# additional_session_principals = ["user:foo@example.com"]
# Example (replace ENGINE_ID after redeploy if needed):
# additional_session_principals = ["principal://agents.global.org-873180247571.system.id.goog/resources/aiplatform/projects/766986452720/locations/us-west1/reasoningEngines/<ENGINE_ID>"]
