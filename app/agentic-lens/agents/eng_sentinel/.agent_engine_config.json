{
  "identity_type": "AGENT_IDENTITY",
  "min_instances": 1,
  "max_instances": 2,
  "resource_limits": {
    "cpu": "4",
    "memory": "8Gi"
  },
  "container_concurrency": 2,
  "env_vars": {
    "GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY": "true",
    "OTEL_SEMCONV_STABILITY_OPT_IN": "gen_ai_latest_experimental",
    "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "true"
  },
  "encryption_spec": {
    "kms_key_name": "projects/agentic-prism/locations/us-west1/keyRings/prism_engineering_kr/cryptoKeys/prism_engineering_key"
  },
  "agent_gateway_config": {
    "client_to_agent_config": {
      "agent_gateway": "projects/agentic-ai-lens/locations/us-central1/agentGateways/gemini-corp-ingress-gateway"
    },
    "agent_to_anywhere_config": {
      "agent_gateway": "projects/agentic-ai-lens/locations/us-central1/agentGateways/gemini-corp-egress-gateway"
    }
  }
}