{
  "identity_type": "AGENT_IDENTITY",
  "min_instances": 1,
  "max_instances": 2,
  "resource_limits": {
    "cpu": "4",
    "memory": "8Gi"
  },
  "container_concurrency": 2,
  "env_vars": {
    "PYTHONPATH": "/code/events_staged",
    "GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY": "true",
    "OTEL_SEMCONV_STABILITY_OPT_IN": "gen_ai_latest_experimental",
    "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "EVENT_ONLY",
    "GOOGLE_GENAI_USE_VERTEXAI": "true",
    "GCP_PROJECT_ID": "agentic-ai-lens",
    "GCP_LOCATION": "us-central1",
    "VERTEX_RAG_PROJECT_ID": "agentic-ai-lens",
    "VERTEX_RAG_LOCATION": "us-west1",
    "VERTEX_RAG_GCS_PATH": "gs://vertex-rag-ingest-agentic-ai-lens/incoming/",
    "VERTEX_RAG_CORPUS_ID": "events-rag",
    "VERTEX_RAG_CORPUS_NAME": "projects/795375693569/locations/us-west1/ragCorpora/2305843009213693952",
    "VERTEX_RAG_DISPLAY_NAME": "agentic-lens-events-rag",
    "VERTEX_RAG_DESCRIPTION": "Managed RAG corpus for Concierge Events",
    "REGION": "us-central1",
    "GOOGLE_API_PREVENT_AGENT_TOKEN_SHARING_FOR_GCP_SERVICES": "false"
  },
  "agent_gateway_config": {
    "client_to_agent_config": {
      "agent_gateway": "projects/agentic-ai-lens/locations/us-central1/agentGateways/gemini-corp-ingress-gateway"
    },
    "agent_to_anywhere_config": {
      "agent_gateway": "projects/agentic-ai-lens/locations/us-central1/agentGateways/gemini-corp-egress-gateway"
    }
  }
}