FROM node:20-alpine AS ui_build

WORKDIR /ui

COPY agentic-lens/glass_ui/package.json ./

RUN npm install

COPY agentic-lens/glass_ui ./

RUN npm run build


FROM python:3.12-slim

RUN apt-get update && apt-get install -y build-essential curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt fastapi uvicorn[standard]

# Only API and backend (no agents, terraform, or venvs)
COPY glass_ui_api.py sitecustomize.py ca-certificates.crt ./
COPY backend /app/backend

COPY --from=ui_build /ui/dist /app/frontend

EXPOSE 8080

ENV GCP_PROJECT_ID=""
ENV GCP_LOCATION="us-west1"

CMD ["uvicorn", "glass_ui_api:app", "--host", "0.0.0.0", "--port", "8080"]

