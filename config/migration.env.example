# Migration control flags — copy to migration/config/migration.env
# Sourced by all migration/scripts/*.sh

# App root (auto-detected: migration/app/ when app/deploy.sh exists)
# REPO_ROOT=/absolute/path/to/migration/app

# --- Phase 1 infra toggles ---
RUN_TELEMETRY=1
RUN_SETUP_KB=1

# Skip repo steps when org already provisioned (1=skip, 0=run)
SKIP_INFRA_MODEL_ARMOR=0
SKIP_INFRA_CMEK=0
SKIP_INFRA_VPC_SC=1
# Set SKIP_INFRA_VPC_SC=0 only if you want repo step 12 AND no org perimeter exists

# Infra step ranges (advanced; leave default for phased scripts)
# PHASE1_STEPS_FROM=01
# PHASE1_STEPS_TO=14

# --- Phase 3 Agent Gateway ---
# 1 = skip gateway workbook (direct UI → Reasoning Engine; default for agentic-lens)
SKIP_AGENT_GATEWAY=1

# --- Phase 4 Glass UI ---
# 1 = allow unauthenticated invoke (dev only; many orgs block allUsers)
GLASS_UI_ALLOW_UNAUTHENTICATED=0

# --- Phase 5 validation ---
RUN_PYTEST=1
RUN_SMOKE=1
SMOKE_PROFILE=smoke

# --- Optional secrets (Phase 1 step 03) ---
# 1 = create github-pat-token with placeholder if missing (replace token before private-repo use)
CREATE_GITHUB_PAT_PLACEHOLDER=1
# Or set real token once: GITHUB_PAT=ghp_... ./scripts/phase1-infra.sh

# Deploy parallelism for ./deploy.sh
DEPLOY_PARALLEL=8
